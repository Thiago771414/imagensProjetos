        <mxCell id="c2" value="B. order.status&#xa;= PAYMENT_FAILED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="650" width="180" height="50" as="geometry" />
