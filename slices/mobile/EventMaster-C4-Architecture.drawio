        <mxCell id="comp-box" value="❌ Caminho de Compensação (rollback) — pagamento recusado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#B85450;fontColor=#C62828;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1380" height="280" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="A. Charge() retorna&#xa;DECLINED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
