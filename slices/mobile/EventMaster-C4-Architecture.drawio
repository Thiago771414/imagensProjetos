        <mxCell id="c3" value="C. ReleaseTickets&#xa;(compensação)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
