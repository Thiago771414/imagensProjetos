        </mxCell>
        <mxCell id="arr-c2-c3" style="endArrow=classic;html=1;rounded=0;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr-c3-c4" style="endArrow=classic;html=1;rounded=0;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr-c4-c5" style="endArrow=classic;html=1;rounded=0;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr-c5-c6" style="endArrow=classic;html=1;rounded=0;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr-c5-c7" style="endArrow=classic;html=1;rounded=0;strokeColor=#B85450;fontSize=10;" edge="1" parent="1" source="c5" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notas-saga" value="&lt;b&gt;Decisões técnicas da SAGA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Estilo:&lt;/b&gt; Orquestração (e não coreografia). Justificativa: o fluxo de compra é curto, transacional e tem regras de negócio centrais que se beneficiam de um único orquestrador (Order) — facilita rastreabilidade, depuração e SLAs.&lt;br&gt;&lt;br&gt;&lt;b&gt;Compensação:&lt;/b&gt; cada step tem operação inversa idempotente (ReleaseTickets, RefundPayment). Identificadores: orderID (idempotency key) e transactionID (PSP).&lt;br&gt;&lt;br&gt;&lt;b&gt;Concorrência no estoque:&lt;/b&gt; lock otimista no PostgreSQL (versão da linha) + reserva temporária no Redis com TTL — protege contra overselling em picos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Falha do orquestrador:&lt;/b&gt; Order Service persiste o estado da SAGA em sua própria base (tabela saga_state). Em caso de crash, reprocessa do último checkpoint via outbox pattern + Kafka." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="920" width="1380" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="5. DDD - Bounded Contexts" id="page-ddd">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-5" value="DDD — Mapa de Contextos Delimitados (Context Map)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1168BD;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-5" value="Quem fala com quem, em que linguagem e qual a relação de poder entre os contextos" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="bc-cat" value="&lt;b&gt;Catálogo de Eventos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Core]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; Event, TicketBatch&lt;br&gt;&lt;b&gt;Entities:&lt;/b&gt; Venue, Category&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; DateRange, Money&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; evento, lote, palco, artista, programação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bc-vendas" value="&lt;b&gt;Vendas / Pedidos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Core]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; Order&lt;br&gt;&lt;b&gt;Entities:&lt;/b&gt; OrderItem, Customer (ref)&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; Money, Discount&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; pedido, item, cupom, total, status (pending/confirmed/failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="160" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bc-est" value="&lt;b&gt;Estoque de Ingressos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Supporting]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; TicketInventory, Reservation&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; SeatNumber, AvailabilityStatus&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; reserva, disponibilidade, lote, alocação, liberação" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="385" y="160" width="290" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bc-pag" value="&lt;b&gt;Pagamento&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Core]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; Payment, Refund&lt;br&gt;&lt;b&gt;Entities:&lt;/b&gt; Transaction&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; CardToken, PixKey, Money&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; cobrança, captura, estorno, autorização, antifraude" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="160" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="bc-id" value="&lt;b&gt;Identidade &amp; Acesso&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Generic]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; User, Role&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; Email, Password (hash), JWT&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; usuário, perfil, escopo, token, refresh" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bc-notif" value="&lt;b&gt;Notificações&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Generic]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; Notification&lt;br&gt;&lt;b&gt;Value Objects:&lt;/b&gt; Channel (Email/SMS/Push), Template&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; envio, template, canal, deliverability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="450" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bc-ana" value="&lt;b&gt;Analytics &amp; Relatórios&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Supporting]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;&lt;b&gt;Aggregates:&lt;/b&gt; SalesReport, AccessMetric&lt;br&gt;&lt;b&gt;Processamento:&lt;/b&gt; Stream (Kafka) + Batch (Cron)&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; KPI, conversão, funil, GMV, repasse" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D4E1F5;strokeColor=#6C8EBF;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="450" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="bc-fraude" value="&lt;b&gt;Antifraude (ACL)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;[Bounded Context — Anticorruption Layer]&lt;/font&gt;&lt;br&gt;&lt;hr&gt;Encapsula fornecedor externo (ClearSale).&lt;br&gt;Traduz modelo externo → modelo interno&lt;br&gt;&lt;b&gt;Ubiquitous Language:&lt;/b&gt; risk_score, decision, blacklist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="450" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="rel-cat-est" value="U/D&#xa;OHS+PL" style="endArrow=classic;html=1;rounded=0;strokeColor=#0E5BA6;fontSize=11;fontStyle=1;fontColor=#0E5BA6;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-cat" target="bc-est">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-est-vendas" value="U/D&#xa;OHS+PL&#xa;(API gRPC)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0E5BA6;fontSize=11;fontStyle=1;fontColor=#0E5BA6;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-est" target="bc-vendas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-vendas-pag" value="Customer-Supplier&#xa;(Vendas é cliente)" style="endArrow=classic;html=1;rounded=0;strokeColor=#0E5BA6;fontSize=11;fontStyle=1;fontColor=#0E5BA6;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-vendas" target="bc-pag">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-pag-fraude" value="ACL" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;fontSize=11;fontStyle=1;fontColor=#666666;startArrow=oval;startFill=0;dashed=1;strokeWidth=2;" edge="1" parent="1" source="bc-pag" target="bc-fraude">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-id-todos" value="Shared Kernel&#xa;(JWT/scopes)" style="endArrow=classic;html=1;rounded=0;strokeColor=#9673A6;fontSize=11;fontStyle=1;fontColor=#9673A6;startArrow=oval;startFill=0;strokeWidth=2;dashed=1;" edge="1" parent="1" source="bc-id" target="bc-vendas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-vendas-notif" value="Pub/Sub&#xa;(Kafka events)" style="endArrow=classic;html=1;rounded=0;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#82B366;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-vendas" target="bc-notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-vendas-ana" value="Pub/Sub" style="endArrow=classic;html=1;rounded=0;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#82B366;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-vendas" target="bc-ana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-pag-ana" value="Pub/Sub" style="endArrow=classic;html=1;rounded=0;strokeColor=#82B366;fontSize=11;fontStyle=1;fontColor=#82B366;startArrow=oval;startFill=0;strokeWidth=2;" edge="1" parent="1" source="bc-pag" target="bc-ana">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legenda-ddd" value="&lt;b&gt;Legenda dos relacionamentos (Context Map)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;U/D&lt;/b&gt; = Upstream / Downstream (quem influencia o modelo de quem)&lt;br&gt;&lt;b&gt;OHS&lt;/b&gt; = Open Host Service — API pública e estável (REST/gRPC)&lt;br&gt;&lt;b&gt;PL&lt;/b&gt; = Published Language — contrato versionado (Protobuf/OpenAPI)&lt;br&gt;&lt;b&gt;ACL&lt;/b&gt; = Anticorruption Layer — isola modelo externo (ex.: antifraude)&lt;br&gt;&lt;b&gt;Customer-Supplier&lt;/b&gt; = downstream pode pedir mudanças ao upstream&lt;br&gt;&lt;b&gt;Shared Kernel&lt;/b&gt; = pequeno modelo comum (JWT claims, IDs)&lt;br&gt;&lt;b&gt;Pub/Sub&lt;/b&gt; = integração assíncrona via eventos de domínio (Kafka)&lt;br&gt;&lt;br&gt;&lt;b&gt;Tipologia (Core / Supporting / Generic)&lt;/b&gt; segue Evans (DDD):&lt;br&gt;● &lt;b&gt;Core Domain&lt;/b&gt;: vantagem competitiva (Catálogo, Vendas, Pagamento)&lt;br&gt;● &lt;b&gt;Supporting&lt;/b&gt;: necessário mas não diferencial (Estoque, Analytics)&lt;br&gt;● &lt;b&gt;Generic&lt;/b&gt;: comoditizável, pode terceirizar (Identidade, Notificações)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#CCCCCC;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="710" width="700" height="380" as="geometry" />
        </mxCell>
        <mxCell id="estrategia-ddd" value="&lt;b&gt;Por que estes 7 contextos e não mais (ou menos)?&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Heurística da linguagem ubíqua:&lt;/b&gt; cada contexto tem termos com semântica própria. &quot;Lote&quot; em Catálogo = configuração de venda; em Estoque = pool físico de assentos. Mesma palavra, modelos diferentes → contextos diferentes.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Heurística da taxa de mudança:&lt;/b&gt; Catálogo muda quando marketing pede; Pagamento muda quando o PSP atualiza API; Notificações muda quando lançamos novo canal. Times independentes = deploys independentes.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Heurística do risco/compliance:&lt;/b&gt; Pagamento tem requisitos PCI-DSS; Identidade tem LGPD. Isolar reduz superfície de auditoria.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Estoque separado de Catálogo:&lt;/b&gt; decisão deliberada. Em monolito eram a mesma tabela. Aqui são contextos distintos porque suas regras de concorrência (lock otimista, TTL) e seu padrão de carga (escrita intensa em pico) não combinam com leitura cacheada do catálogo.&lt;br&gt;&lt;br&gt;&lt;b&gt;5. Antifraude como ACL:&lt;/b&gt; o modelo do fornecedor externo nunca vaza para Pagamento. Trocar ClearSale por Konduto = trocar adapter, modelo de domínio intocado." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="710" width="710" height="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
