          <mxGeometry x="1200" y="220" width="340" height="500" as="geometry" />
        </mxCell>
        <mxCell id="prob-1" value="🔥 &lt;b&gt;Latência em picos&lt;/b&gt;&lt;br&gt;Lançamentos derrubam o sistema; escala vertical limitada (toda a aplicação cresce junta)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="260" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prob-2" value="💾 &lt;b&gt;Inconsistência de dados&lt;/b&gt;&lt;br&gt;Estoque de ingressos e pagamento na mesma transação ACID — overselling em concorrência alta." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="335" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prob-3" value="🛡 &lt;b&gt;SQL Injection (OWASP A03)&lt;/b&gt;&lt;br&gt;Queries dinâmicas sem prepared statements; ausência de WAF e validação centralizada." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="420" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prob-4" value="⛓ &lt;b&gt;Acoplamento forte&lt;/b&gt;&lt;br&gt;Um deploy = todo o sistema reiniciado. Cada bug em &quot;Relatórios&quot; afeta &quot;Vendas&quot;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="505" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prob-5" value="🧪 &lt;b&gt;Testabilidade baixa&lt;/b&gt;&lt;br&gt;Domínios entrelaçados; difícil isolar regras de negócio para TDD/BDD." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1220" y="590" width="300" height="80" as="geometry" />
        </mxCell>
