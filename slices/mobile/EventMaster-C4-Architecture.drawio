        <mxCell id="c4" value="D. estoque retorna&#xa;ao pool disponível" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
