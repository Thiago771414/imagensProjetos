        <mxCell id="c5" value="E. order.failed&#xa;[Kafka]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="790" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="F. notifica falha&#xa;ao cliente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
